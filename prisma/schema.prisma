generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum ItemStatus {
  AVAILABLE
  ON_LOAN
  ON_HOLD
  MISSING
  DAMAGED
  PROCESSING
  IN_REPAIR
  WITHDRAWN
  REFERENCE_ONLY
}

enum ItemStatusChangeReason {
  CHECKOUT
  RETURN
  HOLD
  TRANSFER
  INVENTORY
  DAMAGE
  REPAIR
  LOSS
  WITHDRAWAL
  MANUAL
}

enum LoanRenewalResult {
  APPROVED
  DENIED
}

enum TransactionType {
  CHARGE
  PAYMENT
  WAIVER
  ADJUSTMENT
}

enum CirculationPolicyStatus {
  ACTIVE
  INACTIVE
}

enum MemberCategoryStatus {
  ACTIVE
  INACTIVE
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum HoldStatus {
  QUEUED
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

enum RecordStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model Tenant {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  networks  LibraryNetwork[]
  users     User[]
  libraries Library[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  auditLogs AuditLog[]
  idempotencyKeys IdempotencyKey[]
}

model LibraryNetwork {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  libraries Library[]
  createdAt DateTime  @default(now())
}

model Library {
  id               String                @id @default(cuid())
  tenantId         String
  networkId        String?
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  network          LibraryNetwork?       @relation(fields: [networkId], references: [id], onDelete: SetNull)
  name             String
  slug             String
  branches         Branch[]
  collections      Collection[]
  members          Member[]
  records          BibliographicRecord[]
  createdAt        DateTime              @default(now())
  digitalResources DigitalResource[]
  librarySettings  LibrarySetting[]
  circulationPolicies CirculationPolicy[]
  memberCategories MemberCategory[]
  materialTypes MaterialType[]
  classifications Classification[]
  shelfLocations ShelfLocation[]
  subjects Subject[]
  libraryEvents    LibraryEvent[]
  serialTitles     SerialTitle[]
  userRoles UserRole[] @relation("UserRoleLibrary")

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Branch {
  id        String   @id @default(cuid())
  libraryId String
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?
  items     Item[]
  members   Member[]
  loans     Loan[]
  shelfLocations ShelfLocation[]
  roleAssignments UserRole[] @relation("UserRoleBranch")

  @@unique([libraryId, code])
}

model Collection {
  id          String                @id @default(cuid())
  libraryId   String
  library     Library               @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  records     BibliographicRecord[]
  items       Item[]
}

model User {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  name      String
  status    UserStatus @default(ACTIVE)
  roles     UserRole[]
  auditLogs AuditLog[]
  sessions  Session[]
  statusChanges ItemStatusHistory[]
  loanRenewals LoanRenewal[]
  createdAt DateTime   @default(now())

  @@unique([tenantId, email])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  id String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  libraryId String?
  branchId String?
  library Library? @relation("UserRoleLibrary", fields: [libraryId], references: [id], onDelete: Cascade)
  branch Branch? @relation("UserRoleBranch", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, libraryId, branchId])
  @@index([libraryId, branchId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MemberCategory {
  id String @id @default(cuid())
  libraryId String
  name String
  status MemberCategoryStatus @default(ACTIVE)
  maxLoans Int @default(5)
  loanDays Int @default(21)
  maxRenewals Int @default(3)
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  members Member[]
  @@unique([libraryId, name])
}

model MaterialType {
  id String @id @default(cuid())
  libraryId String
  code String
  name String
  loanable Boolean @default(true)
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  items Item[]
  @@unique([libraryId, code])
}

model Subject {
  id String @id @default(cuid())
  libraryId String
  term String
  authorityUri String?
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  records BibliographicSubject[]
  @@unique([libraryId, term])
}

model BibliographicSubject {
  recordId String
  subjectId String
  record BibliographicRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@id([recordId, subjectId])
}

model Classification {
  id String @id @default(cuid())
  libraryId String
  scheme String
  code String
  label String?
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  records BibliographicRecord[]
  @@unique([libraryId, scheme, code])
}

model ShelfLocation {
  id String @id @default(cuid())
  libraryId String
  branchId String
  code String
  label String
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items Item[]
  @@unique([branchId, code])
}

model CirculationPolicy {
  id String @id @default(cuid())
  libraryId String
  name String
  status CirculationPolicyStatus @default(ACTIVE)
  loanDays Int @default(21)
  maxRenewals Int @default(3)
  dailyFine Decimal @default(0.50)
  graceDays Int @default(0)
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  @@unique([libraryId, name])
}

model Member {
  id                 String              @id @default(cuid())
  libraryId          String
  branchId           String?
  library            Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberNumber       String
  name               String
  email              String?
  phone              String?
  categoryId         String?
  category           MemberCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  legacyCategory     String? @map("category")
  status             MemberStatus        @default(ACTIVE)
  barcode            String?
  loans              Loan[]
  holds              Hold[]
  notes              MemberNote[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  fines              Fine[]
  accountTransactions MemberAccountTransaction[]
  eventRegistrations EventRegistration[]

  @@unique([libraryId, memberNumber])
  @@index([libraryId, name])
}

model MemberNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Author {
  id      String                @id @default(cuid())
  name    String
  kind    String                @default("PERSON")
  records BibliographicAuthor[]
}

model Publisher {
  id      String                @id @default(cuid())
  name    String                @unique
  records BibliographicRecord[]
}

model BibliographicRecord {
  id             String                @id @default(cuid())
  libraryId      String
  collectionId   String?
  publisherId    String?
  library        Library               @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  collection     Collection?           @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  publisher      Publisher?            @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  title          String
  subtitle       String?
  description    String?
  year           Int?
  language       String                @default("en")
  legacyClassification String? @map("classification")
  status         RecordStatus          @default(PUBLISHED)
  coverUrl       String?
  authors        BibliographicAuthor[]
  editions       Edition[]
  holdings       Holding[]
  identifiers    Identifier[]
  subjects       String[]
  subjectLinks   BibliographicSubject[]
  classificationId String?
  classification Classification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  holds          Hold[]
  marcRecord     MarcRecord?

  @@index([libraryId, title])
}

model BibliographicAuthor {
  recordId String
  authorId String
  record   BibliographicRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  author   Author              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([recordId, authorId])
}

model Edition {
  id       String              @id @default(cuid())
  recordId String
  record   BibliographicRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  label    String?
  year     Int?
  isbn     String?
  pages    Int?
  items    Item[]
}

model Identifier {
  id       String              @id @default(cuid())
  recordId String
  record   BibliographicRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type     String
  value    String

  @@unique([type, value])
}

model Holding {
  id        String              @id @default(cuid())
  recordId  String
  record    BibliographicRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  branchId  String
  shelfmark String?
  items     Item[]

  @@unique([recordId, branchId])
}

model Item {
  id           String      @id @default(cuid())
  holdingId    String
  editionId    String?
  branchId     String
  collectionId String?
  shelfLocationId String?
  barcode      String      @unique
  status       ItemStatus  @default(AVAILABLE)
  materialTypeId String?
  materialType   MaterialType? @relation(fields: [materialTypeId], references: [id], onDelete: SetNull)
  legacyMaterialType String? @map("materialType")
  condition    String?
  price        Decimal?
  holding      Holding     @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  edition      Edition?    @relation(fields: [editionId], references: [id], onDelete: SetNull)
  branch       Branch      @relation(fields: [branchId], references: [id])
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  shelfLocation ShelfLocation? @relation(fields: [shelfLocationId], references: [id], onDelete: SetNull)
  loans        Loan[]
  createdAt    DateTime    @default(now())
  holds        Hold[]
  statusHistory ItemStatusHistory[]
  
  @@index([branchId, status])
  }

model Loan {
  id         String     @id @default(cuid())
  memberId   String
  itemId     String
  branchId   String
  loanDate   DateTime   @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  status     LoanStatus @default(ACTIVE)
  member     Member     @relation(fields: [memberId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  renewals   Int        @default(0)
  renewalEvents LoanRenewal[]
  statusChanges ItemStatusHistory[]
  
  @@index([memberId, status])
  @@index([itemId, status])
}

model Hold {
  id        String               @id @default(cuid())
  memberId  String
  recordId  String?
  itemId    String?
  status    HoldStatus           @default(QUEUED)
  priority  Int                  @default(1)
  expiresAt DateTime?
  member    Member               @relation(fields: [memberId], references: [id])
  record    BibliographicRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  item      Item?                @relation(fields: [itemId], references: [id], onDelete: SetNull)
  createdAt DateTime             @default(now())
}

model Fine {
  id           String        @id @default(cuid())
  memberId     String
  amount       Decimal
  reason       String
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  member       Member        @relation(fields: [memberId], references: [id])
  finePayments FinePayment[]
}

model AuditLog {
  id        String      @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  result    AuditResult @default(SUCCESS)
  createdAt DateTime    @default(now())
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model DigitalResource {
  id           String   @id @default(cuid())
  libraryId    String
  title        String
  description  String?
  format       String
  url          String?
  fileSize     Int?
  language     String   @default("en")
  license      String?
  accessPolicy String   @default("PUBLIC")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  library      Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
}

model LibrarySetting {
  id        String  @id @default(cuid())
  libraryId String
  key       String
  value     Json
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([libraryId, key])
}

model MarcRecord {
  id        String              @id @default(cuid())
  recordId  String              @unique
  leader    String?
  directory Json?
  metadata  Json?
  record    BibliographicRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fields    MarcField[]
}

model MarcField {
  id           String         @id @default(cuid())
  marcRecordId String
  tag          String
  ind1         String?
  ind2         String?
  value        String?
  marcRecord   MarcRecord     @relation(fields: [marcRecordId], references: [id], onDelete: Cascade)
  subfields    MarcSubfield[]

  @@index([marcRecordId, tag])
}

model MarcSubfield {
  id      String    @id @default(cuid())
  fieldId String
  code    String
  value   String
  field   MarcField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model FinePayment {
  id     String   @id @default(cuid())
  fineId String
  amount Decimal
  paidAt DateTime @default(now())
  fine   Fine     @relation(fields: [fineId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model LibraryEvent {
  id                 String              @id @default(cuid())
  libraryId          String
  title              String
  description        String?
  startsAt           DateTime
  endsAt             DateTime?
  location           String?
  library            Library             @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  eventRegistrations EventRegistration[]
}

model EventRegistration {
  id        String       @id @default(cuid())
  eventId   String
  memberId  String
  createdAt DateTime     @default(now())
  event     LibraryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

model Vendor {
  id     String  @id @default(cuid())
  name   String
  email  String?
  phone  String?
  active Boolean @default(true)
}

model SerialTitle {
  id        String        @id @default(cuid())
  libraryId String
  title     String
  frequency String?
  vendorId  String?
  status    String        @default("ACTIVE")
  issues    SerialIssue[]
  library   Library       @relation(fields: [libraryId], references: [id], onDelete: Cascade)
}

model SerialIssue {
  id            String      @id @default(cuid())
  serialTitleId String
  issueNumber   String
  expectedAt    DateTime?
  receivedAt    DateTime?
  serialTitle   SerialTitle @relation(fields: [serialTitleId], references: [id], onDelete: Cascade)
}

model Translation {
  id        String @id @default(cuid())
  tenantId  String
  locale    String
  namespace String
  key       String
  value     String

  @@unique([tenantId, locale, namespace, key])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ItemStatusHistory {
  id         String                 @id @default(cuid())
  itemId     String
  fromStatus ItemStatus?
  toStatus   ItemStatus
  reason     ItemStatusChangeReason
  note       String?
  actorId    String?
  loanId     String?
  createdAt  DateTime               @default(now())
  item       Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor      User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)
  loan       Loan?                 @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
}

model LoanRenewal {
  id           String            @id @default(cuid())
  loanId       String
  actorId      String?
  requestedAt  DateTime          @default(now())
  previousDue  DateTime
  newDue       DateTime?
  result       LoanRenewalResult
  reason       String?
  loan         Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  actor        User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([loanId, requestedAt])
}

model MemberAccountTransaction {
  id          String        @id @default(cuid())
  memberId    String
  type        TransactionType
  amount      Decimal
  reference   String?
  description String?
  createdAt   DateTime      @default(now())
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  tenantId     String
  key          String
  operation    String
  requestHash  String
  responseJson Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, operation])
}
